# Herald 환경변수 — 이 파일을 .env 로 복사해서 값을 채운다.
#
# ⚠ .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음).

# ─── 앱 ────────────────────────────────────────────────────
APP_URL=http://localhost:3100

# 호스트 쪽 포트. 컨테이너 안은 항상 3000이다.
# npm run dev 도 같은 3100을 쓴다 — 포트가 갈리면 OAuth redirect 가 어긋난다.
HERALD_PORT=3100

# ─── DB ────────────────────────────────────────────────────
# 컨테이너 안 경로. docker-compose 가 ./data 를 /data 로 마운트한다.
DATABASE_URL=file:/data/herald.db

# ─── 로그인 (Auth.js + Discord OAuth) ──────────────────────
#
#  1) https://discord.com/developers/applications  →  New Application
#  2) OAuth2 탭에서 CLIENT ID / CLIENT SECRET 복사
#  3) OAuth2 > Redirects 에 아래 주소를 "그대로" 추가한다:
#
#       개발   http://localhost:3100/api/auth/callback/discord
#       배포   https://<도메인>/api/auth/callback/discord
#
#     ※ 끝의 /api/auth/callback/discord 를 빠뜨리는 게 제일 흔한 실수다.
#        한 글자라도 다르면 디스코드가 invalid_redirect_uri 로 막는다.
#
# 리버스 프록시(Caddy·Cloudflare Tunnel·도커) 뒤에서 돌기 때문에 Host 헤더를 신뢰해야 한다.
# 이걸 안 켜면 프로덕션 모드에서 UntrustedHost 로 인증이 전부 실패한다.
AUTH_TRUST_HOST=true

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 세션 서명 키.
#   생성: npx auth secret
#   또는: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# 접근을 허용할 디스코드 사용자 ID. 쉼표로 구분.
# ⚠ 비어 있으면 아무도 로그인할 수 없다 (fail-closed). 설정 누락이 개방이 되면 안 된다.
#   내 ID: 디스코드 설정 > 고급 > 개발자 모드 ON → 내 프로필 우클릭 > ID 복사
ALLOWED_DISCORD_IDS=


# ═══════════════════════════════════════════════════════════
# 아래는 다음 단계에서 채운다.
# ═══════════════════════════════════════════════════════════

# ─── 알림 ──────────────────────────────────────────────────
# ⚠ 이 URL 을 아는 사람은 누구나 그 채널에 글을 쓸 수 있다.
DISCORD_WEBHOOK_URL=

# ─── 뉴스 요약 ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── 일정 (네이버 CalDAV) ──────────────────────────────────
# ⚠ 계정 비밀번호가 아니라 반드시 "애플리케이션 비밀번호"를 쓴다.
#    네이버ID > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 관리
NAVER_ID=
NAVER_APP_PASSWORD=

# ─── 자격증명 암호화 마스터 키 ─────────────────────────────
# 위 앱 비밀번호를 DB에 넣을 때 쓰는 키. 32바이트 base64.
ENCRYPTION_KEY=
