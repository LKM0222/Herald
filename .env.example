# Herald 환경변수 — 이 파일을 .env 로 복사해서 값을 채운다.
#
# ⚠ .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음).

# ─── 앱 ────────────────────────────────────────────────────
APP_URL=http://localhost:3100

# 호스트 쪽 포트. 컨테이너 안은 항상 3000이다.
# 다른 서비스와 겹치면 여기만 바꾸면 된다.
HERALD_PORT=3100

# ─── DB ────────────────────────────────────────────────────
# 컨테이너 안 경로. docker-compose 가 ./data 를 /data 로 마운트한다.
DATABASE_URL=file:/data/herald.db


# ═══════════════════════════════════════════════════════════
# 아래는 다음 단계에서 채운다. 지금은 비워둬도 앱이 뜬다.
# ═══════════════════════════════════════════════════════════

# ─── 로그인 (Auth.js + Discord OAuth) ──────────────────────
AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 접근을 허용할 디스코드 사용자 ID. 쉼표로 구분.
ALLOWED_DISCORD_IDS=

# ─── 알림 ──────────────────────────────────────────────────
# ⚠ 이 URL 을 아는 사람은 누구나 그 채널에 글을 쓸 수 있다.
DISCORD_WEBHOOK_URL=

# ─── 뉴스 요약 ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── 일정 (네이버 CalDAV) ──────────────────────────────────
# ⚠ 계정 비밀번호가 아니라 반드시 "애플리케이션 비밀번호"를 쓴다.
#    네이버ID > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 관리
NAVER_ID=
NAVER_APP_PASSWORD=

# ─── 자격증명 암호화 마스터 키 ─────────────────────────────
# 위 앱 비밀번호를 DB에 넣을 때 쓰는 키. 32바이트 base64.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
