# Herald 서버 환경변수 — 이 파일을 server/.env 로 복사해서 값을 채운다.
# npm run dev 와 docker compose 가 같은 파일을 읽는다.
#
# ⚠ .env 는 절대 커밋하지 않는다 (.gitignore 에 등록되어 있음).
# ⚠ 화면(client/)은 GitHub Pages 로 공개 배포되므로, 아래 값이 하나라도
#    클라이언트 번들에 들어가면 안 된다. 전부 서버에서만 읽는다.

# ─── 앱 ────────────────────────────────────────────────────
# 호스트 쪽 포트. 컨테이너 안은 항상 3000이다.
# ⚠ 이 값만은 compose 가 리포 루트의 .env 에서 읽는다. 안 적으면 3100 이 기본값.
HERALD_PORT=3100

# ─── API 접근 ──────────────────────────────────────────────
# 클라이언트가 Authorization: Bearer <값> 으로 보내는 토큰.
# ⚠ 비어 있으면 모든 요청이 401 이다 (fail-closed).
#   생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_TOKEN=

# CORS 허용 오리진. 쉼표로 구분하고 끝에 / 를 붙이지 않는다.
# ⚠ 여기 없는 오리진은 브라우저가 응답을 막는다.
#   예: https://lkm0222.github.io,http://localhost:4173
ALLOWED_ORIGINS=

# 설정·인증 파일(auth.json · settings.json)이 저장되는 곳.
# 도커에선 /data 볼륨이 기본값이라 비워도 된다.
# ⚠ 로컬에서 직접 띄울 때는 반드시 지정한다 — 안 하면 드라이브 루트에 폴더를 만든다.
HERALD_DATA_DIR=./data

# ─── DB ────────────────────────────────────────────────────
# 컨테이너 안 경로. docker-compose 가 ./data 를 /data 로 마운트한다.
DATABASE_URL=file:/data/herald.db


# ═══════════════════════════════════════════════════════════
# 아래는 다음 단계에서 채운다.
# ═══════════════════════════════════════════════════════════

# ─── 알림 ──────────────────────────────────────────────────
# ⚠ 이 URL 을 아는 사람은 누구나 그 채널에 글을 쓸 수 있다.
DISCORD_WEBHOOK_URL=

# ─── 뉴스 요약 ─────────────────────────────────────────────
# 설정 화면에서 넣는 게 기본 경로다. 여기 적으면 화면에서 넣기 전까지의
# 대체값으로 쓰인다 (화면 저장분이 항상 이깁니다).
ANTHROPIC_API_KEY=

# ─── 일정 (네이버 CalDAV) ──────────────────────────────────
# ⚠ 계정 비밀번호가 아니라 반드시 "애플리케이션 비밀번호"를 쓴다.
#    네이버ID > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 관리
NAVER_ID=
NAVER_APP_PASSWORD=

# ─── 자격증명 암호화 마스터 키 ─────────────────────────────
# 설정 화면에서 넣는 API 키·비밀번호를 AES-GCM 으로 감싸는 데 쓴다.
# ⚠ 없으면 서버가 자격증명 저장을 **거부**한다 — 평문으로 두지 않기 위해서다.
# ⚠ 이 값을 바꾸면 기존 저장분을 못 읽는다. 다시 입력해야 한다.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=
